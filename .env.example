# Copie este arquivo para ".env" e troque SUA_SENHA pela senha do usuário postgres
# (a que você definiu ao instalar o PostgreSQL).
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
# Se a senha tiver caracteres especiais, codifique: @ -> %40, # -> %23, / -> %2F
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/biblioteca

# Opcional
SECRET_KEY=troque-por-uma-chave-qualquer-bem-grande
DEBUG=True
